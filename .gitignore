# Data under data/ is committed through Git LFS (see .gitattributes and data/README.md).
# The HDF5 cache is derived from it and re-created on first load.
data/cache/

# The full MagNetX Database (~23 GB of zips, ~33 GB of CSV unpacked) never goes into git.
# Keep it outside the repo (default ~/magnet-data) or here; either way it stays untracked.
MagNetX Database/
MagNetX Database.zip
# Packed copy of the database (src.pack_data, ~8 GB): rebuilt on each machine, not committed.
# No trailing slash: on this Mac data/packed is a symlink to ~/magnet-data/packed.
data/packed

# Reference repo clone (re-create with scripts/fetch_reference.sh)
third_party/

# Scratch training runs; curated tables/plots live elsewhere under results/
results/runs/

__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store
